extends Node
## Global, UI-facing event surface.  Gameplay never talks to widgets directly.

signal judgement(grade: int, delta_ms: float, combo: int, attack_name: String)
signal combo_changed(combo: int)
signal player_health_changed(hp: float, max_hp: float)
signal player_hurt(amount: float)
signal player_dodged()
signal enemy_killed(kind: String)
signal enemy_staggered(kind: String)
signal layer_unlocked(layer: int)
signal layer_queued(layer: int)
signal coda_unlocked()
signal objective_changed(text: String, sub: String)
signal toast(text: String, color: Color)
signal hint(text: String, duration: float)
signal boss_started()
signal boss_health_changed(hp: float, max_hp: float)
signal boss_phase_changed(phase: int)
signal boss_defeated()
signal finale_started()
signal finale_prompt(index: int, action: String, key: String)
signal finale_hit(index: int, success: bool, count: int)
signal finale_finished(success: bool, count: int)
signal countdown(index: int, text: String)
signal shake(strength: float)
signal flash(color: Color, duration: float)
signal stage_changed(index: int, title: String, subtitle: String)
signal settings_changed()
signal player_died()
signal player_respawned()
signal seal_progress(current: int, target: int, requirement: String)
signal seal_completed()
signal note_recovered(total: int)
signal run_finished(victory: bool)
